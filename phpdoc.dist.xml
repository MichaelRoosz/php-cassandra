<?xml version="1.0" encoding="UTF-8" ?>
<!--
    phpDocumentor configuration for the generated API reference in doc/api.
    Run it via `composer doc:api`, which installs the toolchain in tools/doc and
    assembles the markdown theme used below.
-->
<phpdocumentor
        configVersion="3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="https://www.phpdoc.org"
>
    <title>php-cassandra</title>
    <paths>
        <output>doc/api</output>
        <cache>tools/doc/cache</cache>
    </paths>
    <version number="latest">
        <api>
            <source dsn=".">
                <path>src</path>
            </source>
            <!-- Document the public API only. -->
            <visibility>public</visibility>
        </api>
    </version>
    <template name="markdown" location="./tools/doc/build/themes">
        <!-- Print GitLab or GitHub compatible Markdown. Options: github|gitlab -->
        <parameter name="markdownFlavour" value="github"/>
        <!-- Add ".md" to links so they resolve when browsing the repository. Options: yes|no -->
        <parameter name="urlFileExtensions" value="yes"/>
        <!-- Include H1 level title in Markdown. Options: yes|no -->
        <parameter name="includeTitle" value="yes"/>
        <!-- Include a footer with timestamp. Options: yes|no -->
        <parameter name="includeFooter" value="no"/>
    </template>
</phpdocumentor>
