parameters:
    level: max
    paths:
        - test
    excludePaths:
        # Generated pass-through overrides; see test/Support/Faults.php.
        - test/Support/faults-functions.php
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            path: test/Unit/Lz4CompressorTest.php
            identifier: throws.notThrowable
            reportUnmatched: false
